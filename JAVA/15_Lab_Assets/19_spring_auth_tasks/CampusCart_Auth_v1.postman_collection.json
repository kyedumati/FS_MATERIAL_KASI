{
  "info": {
    "_postman_id": "ksr-campuscart-auth-v1",
    "name": "CampusCart Auth v1",
    "description": "Kit 19 / Lab 06 freeze \u2014 register, login, GET catalog public, POST without token (401), POST with Bearer (201), GET by id (200/404), POST invalid with Bearer (400), duplicate register (409). Set baseUrl = http://localhost:8080. Run Register (or Login) before any Bearer POST.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.test('has token', function () { pm.expect(json.token).to.be.a('string'); });",
              "if (json.token) { pm.collectionVariables.set('token', json.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"priya@campuscart.in\",\n  \"password\": \"IdliDosa8\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('token', json.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"priya@campuscart.in\",\n  \"password\": \"IdliDosa8\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Login bad password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', function () { pm.response.to.have.status(401); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"priya@campuscart.in\",\n  \"password\": \"wrong-pass\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "List products public",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Create product without token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', function () { pm.response.to.have.status(401); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pani puri\",\n  \"priceInr\": 30\n}"
        },
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Create product with Bearer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', function () { pm.response.to.have.status(201); });",
              "if (json.id) { pm.collectionVariables.set('productId', String(json.id)); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pani puri\",\n  \"priceInr\": 30\n}"
        },
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Register duplicate",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 409', function () { pm.response.to.have.status(409); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"priya@campuscart.in\",\n  \"password\": \"IdliDosa8\"\n}"
        }
      }
    },
    {
      "name": "Get product by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('has name', function () { pm.expect(pm.response.json().name).to.be.a('string'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products/{{productId}}"
      }
    },
    {
      "name": "Get missing product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 404', function () { pm.response.to.have.status(404); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products/99999"
      }
    },
    {
      "name": "Create product invalid with Bearer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 400', function () { pm.response.to.have.status(400); });",
              "pm.test('error key', function () { pm.expect(pm.response.json().error).to.exist; });",
              "pm.test('fields map', function () { pm.expect(pm.response.json().fields).to.be.an('object'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"priceInr\": 30\n}"
        }
      }
    }
  ]
}
