{
  "info": {
    "_postman_id": "ksr-campuscart-products-v1",
    "name": "CampusCart Products v1",
    "description": "Kit 18 — GET list, GET by id, POST create, POST invalid (400), GET missing (404). Variable baseUrl = http://localhost:8080. Run POST Create before GET by id if the table is empty.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "List products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('body is array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Create product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', function () { pm.response.to.have.status(201); });",
              "pm.test('has id', function () { pm.expect(pm.response.json().id).to.exist; });",
              "var json = pm.response.json();",
              "if (json.id) { pm.collectionVariables.set('productId', String(json.id)); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pani puri\",\n  \"priceInr\": 30\n}"
        },
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Get product by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('has name', function () { pm.expect(pm.response.json().name).to.be.a('string'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products/{{productId}}"
      }
    },
    {
      "name": "Get missing product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 404', function () { pm.response.to.have.status(404); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products/99999"
      }
    },
    {
      "name": "Create product invalid blank name",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 400', function () { pm.response.to.have.status(400); });",
              "pm.test('error key', function () { pm.expect(pm.response.json().error).to.exist; });",
              "pm.test('fields map', function () { pm.expect(pm.response.json().fields).to.be.an('object'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"priceInr\": 30\n}"
        },
        "url": "{{baseUrl}}/products"
      }
    }
  ]
}
